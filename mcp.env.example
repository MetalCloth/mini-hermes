# Copy these entries into ~/.mini-hermes/mcp.env. Keep real keys outside the repository.
# GitHub: a token scoped to the repositories you want to read.
GITHUB_PERSONAL_ACCESS_TOKEN=
# Optional; Context7 also has basic keyless access.
CONTEXT7_API_KEY=
# Microsoft Learn needs no key. Hugging Face supports a user access token.
HF_TOKEN=
# Existing keys in tavily.env / firecrawl.env are also supported.
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
# Optional; Exa has limited keyless access.
EXA_API_KEY=
LINEAR_API_KEY=
# Notion: normally use ./oryn mcp login notion. An existing OAuth access token is optional.
# A Notion integration API key is NOT a hosted MCP OAuth token.
NOTION_ACCESS_TOKEN=
