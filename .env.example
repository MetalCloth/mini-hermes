# Copy this line into ~/.mini-hermes/tavily.env and add your key for web_search.
TAVILY_API_KEY=

# Copy this line into ~/.mini-hermes/firecrawl.env for web_extract and browser tools.
FIRECRAWL_API_KEY=

# Copy these lines into ~/.mini-hermes/mcp.env. Context7 works without a key;
# GitHub stays disabled until a read-only token is supplied.
CONTEXT7_API_KEY=
GITHUB_PERSONAL_ACCESS_TOKEN=

# Optional for UI-TARS experiments; /computer uses your Codex login.
OPENROUTER_API_KEY=

# Gemini placeholder. Copy into ~/.mini-hermes/gemini.env when provider support is added.
# The current Oryn build does not read this key yet.
GEMINI_API_KEY=
