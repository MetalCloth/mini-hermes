# Copy this line into ~/.mini-hermes/tavily.env and add your key for web_search.
TAVILY_API_KEY=

# Copy this line into ~/.mini-hermes/firecrawl.env for web_extract and browser tools.
FIRECRAWL_API_KEY=

# Copy these lines into ~/.mini-hermes/mcp.env. Context7 works without a key;
# GitHub stays disabled until a read-only token is supplied.
CONTEXT7_API_KEY=
GITHUB_PERSONAL_ACCESS_TOKEN=
