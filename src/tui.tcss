/* Palette: OpenCode's default dark theme.
   https://github.com/anomalyco/opencode/blob/dev/packages/tui/src/theme/assets/opencode.json */
$oryn-canvas: #0a0a0a;
$oryn-panel: #141414;
$oryn-element: #1e1e1e;
$oryn-ink: #eeeeee;
$oryn-muted: #808080;
$oryn-peach: #fab283;
$oryn-blue: #5c9cf5;
$oryn-accent: #9d7cd8;

Screen { background: $oryn-canvas; color: $oryn-ink; }
VerticalScroll, OptionList, TextArea {
    scrollbar-size-vertical: 1; scrollbar-size-horizontal: 1;
    scrollbar-background: $oryn-panel;
    scrollbar-background-hover: $oryn-panel; scrollbar-background-active: $oryn-panel;
    scrollbar-color: $oryn-muted;
    scrollbar-color-hover: $oryn-peach; scrollbar-color-active: $oryn-peach;
    scrollbar-corner-color: $oryn-panel;
}
#main-panel { width: 1fr; height: 1fr; align-horizontal: center; }
#topbar { height: 2; padding: 0 2; background: $oryn-panel; align-vertical: middle; }
#topbar-title { width: 1fr; color: $oryn-ink; text-style: bold; overflow: hidden; }
#topbar-project { width: auto; color: $oryn-muted; margin-left: 2; }
#transcript {
    width: 1fr; height: 1fr; padding: 1 2;
    scrollbar-background: $oryn-canvas;
    scrollbar-background-hover: $oryn-canvas; scrollbar-background-active: $oryn-canvas;
    scrollbar-corner-color: $oryn-canvas;
}
#welcome { width: 1fr; height: auto; align: center bottom; padding: 0; }
#welcome-mark { width: 1fr; height: 6; color: $oryn-ink; text-align: center; }
#home-spacer { display: none; height: 1fr; }
#main-panel.home #topbar, #main-panel.home #activity-row { display: none; }
#main-panel.home #transcript { align: center bottom; }
#main-panel.home #composer-wrap { width: 75; max-width: 94%; }
#main-panel.home #home-spacer { display: block; }

.message-card { width: 1fr; height: auto; margin: 1 0; }
.message-body { width: 1fr; height: auto; padding: 0 2; }
.message-card.user .message-body {
    background: $oryn-panel; border-left: solid $oryn-peach; padding: 1 2;
}
.message-copy { width: 1fr; height: auto; color: $oryn-ink; background: transparent; }
.message-meta { height: 1; margin-top: 1; color: $oryn-accent; }
.message-status { display: none; height: auto; margin-bottom: 1; text-style: bold; }
.message-status.cancelled { color: #f5a742; }
.message-status.failed { color: #e06c75; }

#activity-row { height: 1; padding: 0 2; color: $oryn-muted; }
#activity-row.idle Static { visibility: hidden; }
#activity-dot { width: 2; color: $oryn-muted; }
#activity-dot.working { color: $oryn-peach; text-style: bold; }
#activity-label { width: 1fr; color: $oryn-muted; overflow: hidden; }
#activity-label.error { color: #e06c75; }
#tool-count { width: auto; color: $oryn-muted; }
#composer-row { width: 1fr; height: auto; align-horizontal: center; }
#composer-wrap { width: 1fr; height: auto; margin: 0 2 1 2; }
#composer-frame {
    height: auto; min-height: 6; max-height: 12;
    border: none; border-left: solid $oryn-blue;
    background: $oryn-panel; padding: 1 2;
}
#composer {
    height: auto; min-height: 2; max-height: 6;
    border: none; padding: 0; background: transparent; color: $oryn-ink;
}
#composer:focus { border: none; }
.image-attachments { display: none; width: 1fr; height: auto; max-height: 3; color: $oryn-ink; overflow: hidden; }
#composer-meta { height: 1; margin-top: 1; }
#agent-chip { width: auto; color: $oryn-blue; }
#model-separator { width: 3; color: $oryn-muted; content-align: center middle; }
#model-chip, #effort-chip, #speed-chip {
    width: auto; min-width: 0; height: 1; min-height: 1;
    border: none; padding: 0; margin-right: 1;
    background: transparent; color: $oryn-ink; text-style: none;
}
#model-chip:hover, #model-chip:focus,
#effort-chip:hover, #effort-chip:focus,
#speed-chip:hover, #speed-chip:focus { background: $oryn-element; color: $oryn-peach; border: none; }
#provider-chip { width: auto; color: $oryn-muted; }
#composer-footer { height: 1; padding: 0 2; color: $oryn-muted; }
#send-hint { width: 1fr; color: $oryn-muted; }
#composer-commands { width: auto; color: $oryn-muted; }

#palette-overlay {
    overlay: screen; position: absolute;
    width: 100%; max-width: 100%; height: auto; max-height: 10;
    padding: 0 1; border: none; border-left: solid #3c3c3c;
    background: $oryn-element; display: none;
}
#palette-options, #picker-options {
    height: auto; border: none; padding: 0;
    background-tint: transparent;
}
#palette-options {
    max-height: 10; background: $oryn-element;
    scrollbar-background: $oryn-element;
    scrollbar-background-hover: $oryn-element; scrollbar-background-active: $oryn-element;
    scrollbar-corner-color: $oryn-element;
}
#picker-options { max-height: 16; background: $oryn-panel; }
#palette-options > .option-list--option-highlighted,
#palette-options:focus > .option-list--option-highlighted,
#picker-options > .option-list--option-highlighted,
#picker-options:focus > .option-list--option-highlighted {
    background: $oryn-peach; color: $oryn-canvas; text-style: bold;
}
#picker-options > .option-list--option-disabled { color: $oryn-accent; text-style: bold; }
#palette-options > .option-list--option-hover,
#picker-options > .option-list--option-hover { background: #282828; }

#app-footer { width: 1fr; height: 1; padding: 0 2; background: $oryn-canvas; }
#workspace-path { width: 1fr; color: $oryn-muted; overflow: hidden; }
#shortcut-hints { width: auto; color: $oryn-muted; }

ChoiceScreen, TextPromptScreen, InfoScreen, ApprovalScreen {
    align: center middle; background: transparent;
}
#picker-card, #prompt-card, #info-card, #approval-card {
    width: 64; max-width: 92%; height: auto; max-height: 80%;
    padding: 1 2; border: none; background: $oryn-panel;
}
ChoiceScreen.sessions-picker #picker-card { width: 84; }
ToolsScreen #picker-card { width: 100; }
MCPManagerScreen #picker-card { width: 76; }
#picker-title { color: $oryn-ink; text-style: bold; height: 2; content-align: left middle; }
#picker-header { height: 2; }
#picker-header #picker-title { width: 1fr; height: 1; }
#picker-escape { width: 3; color: $oryn-muted; }
#picker-search {
    height: 1; border: none; padding: 0; margin-bottom: 1;
    background: transparent; color: $oryn-ink;
}
#picker-search:focus { border: none; }
#picker-search > .input--cursor { background: $oryn-peach; color: $oryn-canvas; }
#picker-search > .input--placeholder { color: $oryn-muted; }
#picker-empty { height: auto; min-height: 2; color: $oryn-muted; content-align: left middle; }
#picker-details { display: none; height: 2; margin-top: 1; }
#picker-description { height: auto; color: $oryn-muted; }
ToolsScreen #picker-details { height: 4; }
ToolsScreen #picker-options { max-height: 14; }
MCPManagerScreen #picker-details { height: 3; }
#mcp-notice { height: 2; margin-top: 1; color: $oryn-muted; }
#mcp-actions { height: 1; margin-top: 1; }
#mcp-actions Button {
    height: 1; min-height: 1; min-width: 10; width: auto;
    border: none; padding: 0 1; margin-right: 1;
    background: $oryn-element; color: $oryn-ink;
}
#mcp-actions Button:focus, #mcp-actions Button:hover {
    background: $oryn-peach; color: $oryn-canvas;
}
#mcp-actions Button:disabled { color: $oryn-muted; }
#mcp-toggle { width: 12; }
#mcp-reconnect { width: 13; }
#mcp-login { width: 16; }
.modal-hint { height: auto; min-height: 1; color: $oryn-muted; margin-top: 1; }
#prompt-card { width: 60; }
#value-input { height: 2; padding: 0; border: none; border-bottom: solid #3c3c3c; background: $oryn-panel; }
#value-input:focus { border: none; border-bottom: solid $oryn-peach; }
#info-scroll { height: auto; max-height: 50vh; padding: 0; }
#info-card Button { margin-top: 1; align-horizontal: right; }
#approval-card { width: 88; }
#approval-eyebrow { color: $oryn-peach; text-style: bold; height: 1; }
#approval-preview { height: auto; max-height: 50vh; border: none; background: $oryn-element; padding: 1; }
.modal-buttons { height: 1; align-horizontal: right; margin-top: 1; }
TextPromptScreen Button, InfoScreen Button, ApprovalScreen Button {
    height: 1; min-width: 8; border: none; background: $oryn-element; color: $oryn-ink; padding: 0 2;
}
.modal-buttons Button { margin-left: 1; }
#apply, #allow { background: $oryn-peach; color: $oryn-canvas; }
TextPromptScreen Button:hover, InfoScreen Button:hover, ApprovalScreen Button:hover {
    background: #323232; color: $oryn-ink;
}
